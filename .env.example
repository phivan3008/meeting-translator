APP_ENV=development
LOG_LEVEL=INFO
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
WS_MAX_PACKET_BYTES=65536
WS_MAX_STREAMS_PER_SESSION=8
WS_ACK_EVERY_PACKETS=32
WS_ACK_EVERY_MS=200
WS_JITTER_BUFFER_CAPACITY=64
WS_IDLE_TIMEOUT_MS=15000
WS_HEARTBEAT_INTERVAL_MS=5000
WS_RATE_LIMIT_PACKETS_PER_SEC=200.0
WS_RATE_LIMIT_BURST=400
WS_MAX_SESSIONS=500
RECONNECT_BACKOFF_INITIAL_MS=250
RECONNECT_BACKOFF_MAX_MS=10000
RECONNECT_BACKOFF_MULTIPLIER=2.0
CLIENT_OUTBOUND_BUFFER_FRAMES=512
CLIENT_SERVER_URL=ws://localhost:8080/ws/stream
JWT_ISSUER=meeting-translator
JWT_AUDIENCE=meeting-translator-client
JWT_PUBLIC_KEY_PATH=
JWT_ALGORITHM=RS256
JWT_LEEWAY_SECONDS=30
AUTH_DEV_TOKEN=
REDIS_URL=redis://localhost:6379/0

VAD_THRESHOLD=0.50
VAD_SPEECH_START_MS=160
VAD_MIN_SPEECH_MS=250
VAD_SOFT_SILENCE_MS=450
VAD_HARD_SILENCE_MS=900
VAD_SPEECH_PAD_BEFORE_MS=200
VAD_SPEECH_PAD_AFTER_MS=250
VAD_MAX_UTTERANCE_MS=15000

WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_FINAL_BEAM_SIZE=3
WHISPER_PARTIAL_BEAM_SIZE=1
WHISPER_TEMPERATURE=0.0
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true
WHISPER_PARTIAL_INTERVAL_MS=500
WHISPER_AUDIO_OVERLAP_MS=1500
ASR_FINAL_TIMEOUT_MS=8000

VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=qwen3.6-27b-translate
TRANSLATION_TIMEOUT_MS=3000
TRANSLATION_MAX_CONCURRENCY=8
TRANSLATION_MAX_INPUT_TOKENS=768
TRANSLATION_MAX_OUTPUT_TOKENS=256
COMPLETENESS_ENABLED=true
COMPLETENESS_TIMEOUT_MS=250
COMPLETENESS_SKIP_QUEUE_DEPTH=4
COMPLETENESS_MAX_TOKENS=20
COMPLETENESS_MIN_CONFIDENCE=0.55
COMPLETENESS_HEURISTIC_MIN_SPEECH_MS=300
COMPLETENESS_HEURISTIC_MAX_UNSTABLE_TAIL_CHARS=12
TRANSLATION_QUEUE_CAPACITY_PER_PRIORITY=16

READINESS_CHECK_TRANSLATION_BACKEND=false
READINESS_CHECK_TIMEOUT_MS=500
SHUTDOWN_DRAIN_TIMEOUT_MS=10000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

STORE_RAW_AUDIO=false
LOG_TRANSCRIPT_CONTENT=false
LOG_TRANSLATION_CONTENT=false
